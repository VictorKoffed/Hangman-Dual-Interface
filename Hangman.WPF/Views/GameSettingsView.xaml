<!-- 
    This UserControl serves as the unified configuration view for both SinglePlayer and Tournament modes.
    By binding to a shared GameSettingsViewModel, we adhere to the DRY principle (Don't Repeat Yourself), 
    dynamically adjusting the UI state (like hiding the second player's input) based on the chosen mode.
    All visible text is bound to the localization provider to support dynamic language switching without recompilation.
-->
<UserControl x:Class="Hangman.WPF.Views.GameSettingsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:local="clr-namespace:Hangman.WPF.Views"
             mc:Ignorable="d" 
             d:DesignHeight="450" d:DesignWidth="800">

    <UserControl.Resources>
        <!-- 
            WPF's Visibility property expects an enum (Visible, Collapsed, Hidden) rather than a boolean. 
            This built-in converter bridges the gap, allowing us to bind UI visibility directly 
            to straightforward boolean properties in our ViewModel without polluting the backend with UI-specific types.
        -->
        <BooleanToVisibilityConverter x:Key="BoolToVis" />
    </UserControl.Resources>

    <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center" Width="300">

        <TextBlock Text="{Binding Strings.SettingsTitle}" FontSize="32" FontWeight="Bold" HorizontalAlignment="Center" Margin="0,0,0,20"/>

        <TextBlock Text="{Binding Strings.PromptPlayer1Name}" Margin="0,10,0,0"/>
        <TextBox Text="{Binding CurrentSettings.PlayerName}" Margin="0,5" Padding="5"/>

        <!-- 
            This section is conditionally rendered. If the user selected SinglePlayer mode, 
            prompting for a second player's name would be confusing and lead to an invalid state.
            The converter handles collapsing this panel seamlessly when IsTournamentMode is false,
            freeing up physical screen real estate.
        -->
        <StackPanel Visibility="{Binding IsTournamentMode, Converter={StaticResource BoolToVis}}">
            <TextBlock Text="{Binding Strings.PromptPlayer2Name}" Margin="0,5,0,0"/>
            <TextBox Text="{Binding CurrentSettings.PlayerName2}" Margin="0,5" Padding="5"/>
        </StackPanel>

        <TextBlock Text="{Binding Strings.SettingsLabelDifficulty}" Margin="0,10,0,0"/>
        <!-- 
            DisplayMemberPath and SelectedValuePath are utilized here to decouple the presentation 
            from the underlying data structure. The user sees a localized, human-readable string (Value), 
            while the ViewModel securely receives the actual Enum mapping (Key) needed for business logic.
        -->
        <ComboBox ItemsSource="{Binding LocalizedDifficulties}" 
                  SelectedValue="{Binding CurrentSettings.Difficulty}"
                  DisplayMemberPath="Value"
                  SelectedValuePath="Key"
                  Margin="0,5" Padding="5"/>

        <TextBlock Text="{Binding Strings.SettingsLabelWordList}" Margin="0,10,0,0"/>
        <ComboBox ItemsSource="{Binding WordSources}" 
                  SelectedValue="{Binding CurrentSettings.Source}"
                  DisplayMemberPath="Value"
                  SelectedValuePath="Key"
                  Margin="0,5" Padding="5"/>

        <Button Content="{Binding Strings.SettingsButtonStart}" 
                Command="{Binding StartGameCommand}" 
                Margin="0,20,0,0" Padding="10" FontWeight="Bold" FontSize="16"/>

        <Button Content="{Binding Strings.ButtonBackToMenu}" 
                Command="{Binding BackToMenuCommand}" 
                Margin="0,10" Padding="5" Background="LightGray"/>

    </StackPanel>
</UserControl>
