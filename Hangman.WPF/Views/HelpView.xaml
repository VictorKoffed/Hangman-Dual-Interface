<!-- 
    This UserControl serves as the informational view for the application, detailing game rules, modes, and data sources.
    In accordance with the MVVM architectural pattern, this view relies entirely on data binding. 
    It binds to a HelpViewModel which provides the localized strings and navigation commands, 
    ensuring that the presentation layer remains completely decoupled from business and routing logic.
-->
<UserControl x:Class="Hangman.WPF.Views.HelpView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             mc:Ignorable="d" 
             d:DesignHeight="450" d:DesignWidth="800">
    <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center" Width="450">

        <!-- 
            All text elements bind directly to the 'Strings' property (the localization provider). 
            This dynamic binding is crucial for supporting runtime language switching without requiring 
            application restarts or the maintenance of duplicate, language-specific XAML views.
        -->
        <TextBlock Text="{Binding Strings.HelpTitle}" FontSize="24" FontWeight="Bold" HorizontalAlignment="Center" Margin="0,0,0,20"/>

        <!-- 
            TextWrapping="Wrap" is explicitly applied to these instructional blocks. 
            Since the length of localized text is unpredictable and varies between languages (e.g., Swedish vs. English), 
            this ensures the UI remains resilient and prevents text from overflowing the container's fixed width or being visually clipped.
        -->
        <TextBlock Text="{Binding Strings.HelpLine1}" TextWrapping="Wrap" FontSize="14" Margin="0,10,0,0"/>
        <TextBlock Text="{Binding Strings.HelpLine2}" TextWrapping="Wrap" FontSize="14"/>

        <TextBlock Text="{Binding Strings.HelpModesTitle}" FontSize="18" FontWeight="Bold" Margin="0,15,0,5"/>
        <TextBlock Text="{Binding Strings.HelpModesLine1}" TextWrapping="Wrap" FontSize="14" Margin="10,0,0,0"/>
        <TextBlock Text="{Binding Strings.HelpModesLine2}" TextWrapping="Wrap" FontSize="14" Margin="10,0,0,0"/>

        <TextBlock Text="{Binding Strings.HelpSourcesTitle}" FontSize="18" FontWeight="Bold" Margin="0,15,0,5"/>
        <TextBlock Text="{Binding Strings.HelpSourcesLine1}" TextWrapping="Wrap" FontSize="14" Margin="10,0,0,0"/>
        <TextBlock Text="{Binding Strings.HelpSourcesLine2}" TextWrapping="Wrap" FontSize="14" Margin="10,0,0,0"/>
        <TextBlock Text="{Binding Strings.HelpSourcesLine3}" TextWrapping="Wrap" FontSize="14" Margin="10,0,0,0"/>

        <Button Content="{Binding Strings.ButtonBackToMenu}" Command="{Binding BackToMenuCommand}" HorizontalAlignment="Center" Margin="0,30" Padding="10"/>
    </StackPanel>
</UserControl>
